{#-
  GitHub Actions and Jinja both use {{ }}, so the workflow body lives inside {% raw %}
  blocks and only the generated matrix steps out of them.
-#}
{%- macro dj_next(version) -%}
{%- set parts = version.split(".") -%}
{%- if parts[1] == "2" %}{{ parts[0] | int + 1 }}.0{% else %}{{ parts[0] }}.{{ parts[1] | int + 1 }}{% endif %}
{%- endmacro -%}
{%- raw -%}
name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  FORCE_COLOR: "1"
  UV_FROZEN: "1"

permissions:
  contents: read

jobs:
  lint:
    name: Lint and type check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true

      - name: Install the project
        run: uv sync --all-groups

      - run: uv run ruff check --output-format=github .
      - run: uv run ruff format --check .
      - run: uv run mypy

      - name: Check for missing migrations
        run: uv run python -m tests.manage makemigrations --check --dry-run

  test:
    name: Python ${{ matrix.python-version }} / Django ${{ matrix.django }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        # Spelled out rather than a product: each Django release supports a
        # different span of interpreters.
        include:
{%- endraw %}
{%- for python in python_versions %}
{%- for django in django_versions %}
{%- if python in python_support[django] %}
          - python-version: "{{ python }}"
            django: "{{ django }}"
            django_spec: "django>={{ django }},<{{ dj_next(django) }}"
{%- endif %}
{%- endfor %}
{%- endfor %}
{% raw %}
    steps:
      - uses: actions/checkout@v5

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
          python-version: ${{ matrix.python-version }}

      - name: Install the project
        run: uv sync --all-groups

      - name: Pin Django ${{ matrix.django }}
        run: uv pip install "${{ matrix.django_spec }}"

      - name: Show the resolved versions
        run: uv run --no-sync python -c "import django, sys; print(sys.version); print(django.get_version())"

      - name: Run the test suite
        run: >-
          uv run --no-sync pytest --cov --cov-report=xml --cov-report=term-missing
{%- endraw %}

      - name: Upload coverage
        if: matrix.python-version == '{{ python_latest }}' && matrix.django == '{{ django_latest }}'
        uses: actions/upload-artifact@v5
        with:
          name: coverage
          path: coverage.xml
          if-no-files-found: error
{%- if test_django_main %}

  # Django's main branch breaks for reasons that are not this project's fault, so it
  # reports without gating the merge.
  django-main:
    name: Django main (informational)
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v5

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
          python-version: "{{ python_latest }}"

      - name: Install the project
        run: uv sync --all-groups

      - name: Install Django from main
        run: uv pip install "https://github.com/django/django/archive/main.tar.gz"

      - name: Run the test suite
        run: uv run --no-sync pytest -q
{%- endif %}
{% raw %}
  build:
    name: Build the distribution
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true

      - run: uv build

      - name: Check the metadata renders on PyPI
        run: uvx twine check --strict dist/*

      - uses: actions/upload-artifact@v5
        with:
          name: dist
          path: dist/
          if-no-files-found: error

  pre-commit:
    name: pre-commit
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true

      - run: uv sync --all-groups

      - name: Run every hook
        run: uv run pre-commit run --all-files --show-diff-on-failure
{%- endraw %}
